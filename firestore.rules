rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return isSignedIn() && userData().role != null ? userData().role : 'viewer';
    }

    function userBranches() {
      return isSignedIn() && userData().branchIds != null ? userData().branchIds : [];
    }

    function isOwnerOrAdmin() {
      return userRole() in ['owner', 'admin'];
    }

    function isStockKeeper() {
      return userRole() in ['owner', 'admin', 'stock_keeper'];
    }

    // User profile: user can read their own doc; admins can read all. Writes restricted.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwnerOrAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isOwnerOrAdmin());
    }

    // Products: readable by any signed-in user; writable by owner/admin.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwnerOrAdmin();
    }

    // Warehouses: readable by signed-in; writable by owner/admin.
    match /warehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwnerOrAdmin();
    }

    // Stock movements: readable by signed-in; writable by owner/admin/stock keeper.
    match /stock_movements/{movementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isStockKeeper();
    }

    // Fallback deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
